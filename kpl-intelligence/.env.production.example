# ==============================================================================
# 康平路情报站 (KPL Intelligence) 生产环境配置模板 (.env.production.example)
# ==============================================================================
# 使用说明：
# 1. 复制本文件到项目根目录作为 .env：
#    cp .env.production.example .env
# 2. 依次填入各项必填配置，并根据服务器规模核对连接池上限
# 3. 严禁将包含真实密钥与数据库密码的 .env 提交至 Git 仓库！
# ==============================================================================

# ===== 1. 基础站点与网络暴露 =====

# 网站对外完整根地址（末尾无斜杠），用于生成 Canonical、RSS、OG 图片及 MCP
SITE_URL=https://kpl.example.com

# 绑定的生产域名（供 Caddy 自动申请 TLS 证书与反向代理使用）
SITE_DOMAIN=kpl.example.com

# Node 运行环境（生产环境固定为 production）
NODE_ENV=production
AIHOT_ENVIRONMENT=production
AIHOT_RELEASE=v1.0.0

# 外部反向代理（Caddy/Nginx）信任头部（设为 true 读取真实客户端 IP）
TRUST_PROXY=true

# 服务端口与绑定（容器内默认 3000 与 3001）
# 托管平台的 PORT 可覆盖 WEB_PORT；留空保持下方 Web 端口。API 端口不受影响。
PORT=
WEB_PORT=3000
API_PORT=3001
API_BASE_URL=http://api:3001
LOCAL_ROUTER_URL=http://web:3000

# 日志级别 (trace | debug | info | warn | error)
LOG_LEVEL=info

# ===== 2. 安全与鉴权密钥 (必填) =====

# 管理员后台密码（至少 12 位高强度密码，登录 /admin 用）
ADMIN_PASSWORD=

# 会话签名密钥（生成方式: openssl rand -hex 32）
SESSION_SECRET=

# 图片防盗链代理签名密钥（生成方式: openssl rand -hex 32）
IMG_PROXY_SIGN_SECRET=

# 外部数据推送鉴权 Token（至少 16 位，POST /api/ingest/items 用，可选）
INGEST_TOKEN=

# ===== 3. 生产数据库配置 (Supabase / PostgreSQL) =====

# 数据库连接串（必须带 sslmode=require）：
# 推荐优先使用 Supabase Session Pooler (db.<ref>.pooler.supabase.com:5432) 或 Direct
# 【安全红线】请在 Supabase 控制台 Project Settings -> API 中关闭 Data API (PostgREST)，
# 避免公共 anon key 穿透数据库，所有请求必须统一走 Fastify API 接口！
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# 【连接池预算】防止容器并发启动争抢导致 Supabase 报错 EMAXCONNSESSION
# Web / API 单进程连接池上限（建议 3-5）
DATABASE_POOL_MAX=3
# Worker 后台队列连接池上限（建议 2）
PGBOSS_POOL_MAX=2

# ===== 4. 核心大模型 (LLM) =====

# 默认 OpenAI 兼容协议接口（推荐 DeepSeek）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 服务商特有参数（关闭深度思考以保障稳定吞吐）
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}

# 模型能力标记
LLM_VISION=false
LLM_JSON_MODE=true

# ===== 5. 向量检索模型 (Embedding) =====

# 阿里云百炼向量（用于赛事讨论归组与语义聚类）
DASHSCOPE_API_KEY=
# 或者标准 OpenAI 兼容接口：
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMS=1024

# ===== 6. 生产安全开关 =====

# 采集与大模型调用开关（首次冷启动建议保持 true，如需纯只读冒烟可暂设为 false）
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# 监控静默告警阈值（分钟，默认 360 分钟无新收录时触发）
ALERT_QUIET_MINUTES=360

# ===== 7. 选填：信源扩展抓取渠道 =====

# 微信公众号采集通道（二选一）：
# DAJIALA_KEY=
# WEREAD_COOKIE=

# 网页深度提取降级（Jina Reader API）：
# JINA_API_KEY=

# B站 / 社区采集出海或翻墙代理（若服务器位于海外直连即可）：
# EGRESS_PROXY_URL=http://127.0.0.1:7890

# ===== 8. 选填：运营与告警通知 =====

# 飞书群通知与告警：
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_ALERT_CHAT_ID=
# FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
